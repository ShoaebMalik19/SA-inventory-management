# Leave DATABASE_URL empty to use the built-in database on your laptop (stored in ./.data).
# For going live, paste your Supabase "Transaction pooler" connection string here (and in Vercel):
#   Supabase → Project → Connect → Transaction pooler → URI   (port 6543)
DATABASE_URL=

# Optional. A long random string used to sign login cookies.
# If empty, one is generated and stored in the database on first start.
SESSION_SECRET=
